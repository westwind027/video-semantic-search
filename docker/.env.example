# Copy this file to docker/.env before starting Compose.
# Keep secrets here only on the local machine; docker/.env is ignored by Git.

VIDEO_SEARCH_PUBLIC_URL=http://localhost:8000
VIDEO_SEARCH_PORT=8000
VIDEO_SEARCH_MEDIA_DIR=../media
IMAGE_NAMESPACE=westwind027
IMAGE_TAG=clean-release-v1.0

# GPU defaults. Set EMBEDDING_BACKEND=hash and IDENTITY_BACKEND=hash for a
# dependency-light API smoke test; real visual/face search uses the defaults.
EMBEDDING_BACKEND=wemm
WEMM_MODEL=tencent/WeMM-Embedding-2B
EMBEDDING_DIMENSION=2048
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=8
IDENTITY_ENABLED=true
IDENTITY_BACKEND=insightface
IDENTITY_DEVICE=cuda
FACE_MODEL=buffalo_l

# Optional Hugging Face authentication for model download.
HF_TOKEN=

# Optional metadata and Aliyun Drive integrations.
TMDB_API_KEY=
TMDB_PROXY_URL=
ALIYUNPAN_LOGIN_MODE=tickstep
ALIYUNPAN_CLIENT_ID=
ALIYUNPAN_CLIENT_SECRET=
ALIYUNPAN_TICKSTEP_IP=
ALIYUNPAN_WEB_REFRESH_TOKEN=
